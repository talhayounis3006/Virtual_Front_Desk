PORT=5000

# MongoDB — for vector search, use a MongoDB Atlas URI (not in-memory)
# For Atlas: mongodb+srv://user:pass@cluster.xxxxx.mongodb.net/virtual-frontdesk
MONGODB_URI=mongodb://localhost:27017/virtual-frontdesk

JWT_SECRET=your_jwt_secret_here
JWT_EXPIRE=7d

# OpenAI — required for embeddings + AI chat with function calling
OPENAI_API_KEY=your_openai_api_key_here

# Stripe (test mode keys — use test sk_ and pk_ keys from https://dashboard.stripe.com/test/apikeys)
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_signing_secret

# Client URL (used for Stripe redirect URLs)
CLIENT_URL=http://localhost:3000

# SMTP / Email (used for appointment reminders and review requests)
# If left empty, the app will use an Ethereal test account (emails viewable at ethereal.email)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
SMTP_FROM=noreply@frontdesk.app
